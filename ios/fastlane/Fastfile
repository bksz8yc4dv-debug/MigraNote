default_platform(:ios)

platform :ios do
  desc "Build and upload MigraNote to TestFlight"
  lane :beta do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT_BASE64 APPLE_TEAM_ID]
    missing = required.select { |key| ENV[key].to_s.empty? }
    UI.user_error!("Missing GitHub secrets: #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true
    )

    build_app(
      project: "MigraNote.xcodeproj",
      scheme: "MigraNote",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      api_key: api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      xcargs: "CODE_SIGN_STYLE=Automatic CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
